# ==============================================================================
# YouTube Content Automation Studio - Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git -- it is listed in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Generation Provider API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
UNREALSPEECH_API_KEY=your_unrealspeech_api_key_here
POLLINATIONS_API_KEY=
SHOTSTACK_API_KEY=your_shotstack_api_key_here

# ------------------------------------------------------------------------------
# 2. Publishing & Notification Credentials
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# Legacy Gmail fields (also used as SMTP fallback)
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# 2b. SMTP Email Notification Settings (EmailAgent)
# How to create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search for "App passwords" -> select "Mail" + device -> Generate
#   4. Copy the 16-character password into SMTP_PASSWORD below
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=Shorts Automation

# ------------------------------------------------------------------------------
# 3. n8n Workflow Server Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/webhook/youtube-automation-run

# ------------------------------------------------------------------------------
# 4. Frontend Web Server
# ------------------------------------------------------------------------------
PORT=8080
